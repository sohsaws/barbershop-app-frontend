{
  "name": "barbershop-app-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --project tsconfig.test.json --noEmit",
    "test:lint": "eslint tests vitest.config.ts --max-warnings 0",
    "test:check": "npm run test:lint && npm run test:types && npm test",
    "test:service-edit": "vitest run tests/service-edit.test.ts",
    "test:feedback": "vitest run tests/form-feedback.test.ts",
    "preview": "vite preview",
    "openspec": "openspec"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@tanstack/react-query": "^5.94.5",
    "@tma.js/sdk-react": "^3.0.22",
    "axios": "^1.13.6",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "swiper": "^12.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fission-ai/openspec": "^1.16.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jest-dom": "^5.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^16.5.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0-beta.13",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
